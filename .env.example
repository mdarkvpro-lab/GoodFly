# Aéroport de départ par défaut dans la barre de réservation (RBA ou CMN)
NEXT_PUBLIC_HOME_AIRPORT_CODE=RBA

# Supabase (phase 5 — aucun projet créé pour l'instant)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# NE JAMAIS mettre la clé service-role ici ni sur le site.
# Elle vit uniquement sur le PC du propriétaire, dans la console locale.

# Clé serveur pour les demandes de réservation (jamais NEXT_PUBLIC_, jamais dans git).
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# puis enregistrer son SHA-256 dans private.settings ('booking_form_key_sha256').
BOOKING_FORM_KEY=

# Adresse publique du site (https://…, sans / final) : sert au lien dans les alertes Telegram.
SITE_URL=

# Alertes Telegram (remplies par : npm run telegram:setup — ne jamais coller le token dans un chat).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Cloudflare Turnstile (anti-robot du formulaire de réservation). Vide = désactivé.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Web Push (alertes sur les téléphones de l'équipe, gratuit). Générer une fois :
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:goodfly64@gmail.com
