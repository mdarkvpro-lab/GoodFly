# Copy to owner-console/.env.local (never commit it, never put it on the website).
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Supabase → Project settings → API → service_role key. Full access to the database: keep it on this PC only.
SUPABASE_SERVICE_ROLE_KEY=
# Generate with: npm run owner:passcode
OWNER_PASSCODE_HASH=
OWNER_PORT=4000
MAX_DIRECTION=2
